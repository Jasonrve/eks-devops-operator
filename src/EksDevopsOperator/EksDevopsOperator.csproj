<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CRDs are generated by `EksDevopsOperator generate-crds`, not by the KubeOps CLI build step -->
    <GenerateOperatorResources>false</GenerateOperatorResources>

    <!-- small and lean runtime: invariant culture needs no ICU, one GC heap, no background GC thread, only English resources -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the Kubernetes client and our status writes use reflection-based System.Text.Json; keep it on when the framework is trimmed -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.EKS" Version="4.0.107.4" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="4.0.103.13" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.6" />
    <PackageReference Include="KubeOps.Operator" Version="13.3.4" />
  </ItemGroup>

</Project>
